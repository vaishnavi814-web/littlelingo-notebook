{
  "name": "english-notebook",
  "version": "1.0.0",
  "private": true,
  "description": "littlelingo — offline English notebook desktop app",
  "main": "electron/main.js",
  "scripts": {
    "build:client": "npm run build --prefix client",
    "copy:client": "node scripts/copy-client.js",
    "icons": "node scripts/make-icons.js",
    "package": "electron-builder",
    "build:windows": "npm run build:client && npm run copy:client && npm run package -- --win nsis",
    "build": "npm run build:windows",
    "electron": "electron ."
  },
  "files": [
    "electron/**/*",
    "server/index.js",
    "server/store.js",
    "server/routes/**/*",
    "server/models/**/*",
    "server/public/**/*",
    "!server/.env",
    "!server/uploads/**/*",
    "!server/data/**/*",
    "!server/node_modules/**/*",
    "package.json"
  ],
  "build": {
    "appId": "com.littlelingo.notebook",
    "productName": "littlelingo",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "client/public/favicon.svg"
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "sql.js": "^1.15.2"
  }
}
