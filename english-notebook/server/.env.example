PORT=5000
HOST=127.0.0.1
# MongoDB Atlas connection string - copy it from Atlas: Clusters -> Connect -> Drivers (Node.js).
# Example: mongodb+srv://littlelingo:<password>@cluster0.xxxxx.mongodb.net/littlelingo?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/littlelingo?retryWrites=true&w=majority
OLLAMA_MODEL=llama3.2:3b
# Base URL of the Ollama server used by /api/ai (default: http://127.0.0.1:11434)
OLLAMA_URL=http://127.0.0.1:11434
# Optional: where uploaded images live. On Render use /var/data (persistent disk).
# DATA_DIR=/var/data