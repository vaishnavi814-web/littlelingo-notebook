# Copy to .env and fill in locally. Never commit .env.
# The API reads MONGO_URI (not MONGODB_URI) and MONGO_DB.
PORT=5000
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/
MONGO_DB=littlelingo
REQUIRE_MONGO=true
ALLOWED_ORIGIN=https://littlelingo-alpha.vercel.app

# Single admin account for the moderation inbox.
# Use a long, unique password. ADMIN_PASSWORD_HASH (salt:hash from scrypt) is
# accepted instead of ADMIN_PASSWORD if you prefer not to store the plain value.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
# ADMIN_PASSWORD_HASH=

# Optional AI helper (not needed for accounts or chat).
OLLAMA_URL=
OLLAMA_MODEL=llama3.2:3b
